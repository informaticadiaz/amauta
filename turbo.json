{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": []
    },
    "type-check": {
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": []
    },
    "test:e2e:api": {
      "cache": false,
      "dependsOn": []
    },
    "test:e2e:frontend": {
      "cache": false,
      "dependsOn": []
    }
  }
}
