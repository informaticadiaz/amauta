# ==================================
# E2E TEST ENVIRONMENT
# ==================================
# Copiar a .env.local y ajustar para entorno local.
# Por defecto, los tests apuntan a producción.
#
# NUNCA commitear .env.local

# URL del frontend (Next.js)
# Default: https://amauta.diazignacio.ar
FRONTEND_URL=http://localhost:3000

# URL de la API (NestJS)
# Default: https://amauta-api.diazignacio.ar
API_URL=http://localhost:3001

# ==================================
# USUARIOS DE PRUEBA
# ==================================
# Usuarios preexistentes en la base de datos de prueba.
# Ver apps/api/prisma/README.md para la tabla completa.

E2E_USER_SUPERADMIN=superadmin@amauta.test
E2E_USER_ADMIN=admin1@amauta.test
E2E_USER_EDUCADOR=educador1@amauta.test
E2E_USER_ESTUDIANTE=estudiante1@amauta.test
E2E_PASSWORD=password123
